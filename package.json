{
  "name": "hindsight",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter='./packages/*' build && pnpm -r --filter='./apps/*' build",
    "typecheck": "pnpm -r typecheck",
    "dev": "pnpm -r --parallel dev",
    "doctor": "tsx scripts/doctor.ts",
    "provision:signoz": "tsx scripts/provision-signoz.ts",
    "test:provision": "tsx --test scripts/provision-signoz.test.ts",
    "validate:infra": "tsx scripts/validate-infra.ts"
  },
  "devDependencies": {
    "tsx": "^4.23.1",
    "typescript": "^5.6.3"
  }
}
