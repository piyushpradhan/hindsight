{
  "name": "@hindsight/replay-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "tsx --test src/config.test.ts src/rungraph/builder.test.ts src/replay/replay.test.ts src/compare/diff.test.ts src/fork/executor.test.ts src/webhooks/signoz.test.ts src/incidents/store.test.ts src/incidents/verify.test.ts src/routes.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@hindsight/demo-agents": "workspace:*",
    "@hindsight/recorder": "workspace:*",
    "@hindsight/shared": "workspace:*",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.220.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-metrics": "^2.9.0",
    "@opentelemetry/sdk-trace-node": "^2.9.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "better-sqlite3": "^12.11.1",
    "fastify": "^5.10.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
