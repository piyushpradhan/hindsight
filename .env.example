# SigNoz query API service-account key.
SIGNOZ_API_KEY=

# Bearer secret configured on the SigNoz webhook notification channel.
SIGNOZ_WEBHOOK_SECRET=
SIGNOZ_WEBHOOK_URL=http://host.docker.internal:4123/hooks/signoz

# Engine security. The quickstart is loopback-only; remote binds must set an
# API token and disable the localhost bypass.
HOST=127.0.0.1
HINDSIGHT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
HINDSIGHT_API_TOKEN=
HINDSIGHT_ALLOW_UNAUTHENTICATED_LOCALHOST=true

# Agent ID -> fixed runner URL and exact runtime revision.
HINDSIGHT_RUNNERS={"research":{"url":"http://127.0.0.1:4124","revision":"demo-research@1"},"support-triage":{"url":"http://127.0.0.1:4124","revision":"demo-support-triage@1"},"codex":{"url":"http://127.0.0.1:4124","revision":"codex-hindsight@ac879e5"},"todo-triage":{"url":"http://127.0.0.1:4124","revision":"todo-triage@1"}}

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Taskline provider: ollama (local), anthropic, or offline (deterministic).
HINDSIGHT_TODO_PROVIDER=ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:1b
ANTHROPIC_API_KEY=
