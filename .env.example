# SigNoz query API service-account key.
SIGNOZ_API_KEY=

# Bearer secret configured on the SigNoz webhook notification channel.
SIGNOZ_WEBHOOK_SECRET=

# Agent ID -> fixed runner URL and exact runtime revision.
HINDSIGHT_RUNNERS={"research":{"url":"http://127.0.0.1:4124","revision":"demo-research@1"},"support-triage":{"url":"http://127.0.0.1:4124","revision":"demo-support-triage@1"}}

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
