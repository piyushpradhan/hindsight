{
  "//": "UNINSTALLED TEMPLATE. Run-specific rule for POST /api/v2/rules, target SigNoz v0.133.x.",
  "hindsightInstallStatus": "template_uninstalled",
  "alert": "Hindsight: recorded run failed",
  "alertType": "LOGS_BASED_ALERT",
  "ruleType": "threshold_rule",
  "version": "v5",
  "schemaVersion": "v2alpha1",
  "evalWindow": "1m0s",
  "frequency": "30s",
  "severity": "critical",
  "condition": {
    "compositeQuery": {
      "queryType": "builder",
      "panelType": "graph",
      "queries": [
        {
          "type": "builder_query",
          "spec": {
            "name": "A",
            "signal": "logs",
            "source": "",
            "stepInterval": 0,
            "aggregations": [
              { "expression": "count()" }
            ],
            "filter": {
              "expression": "hindsight.event.name = 'run_failed'"
            },
            "groupBy": [
              { "name": "trace_id" },
              { "name": "hindsight.agent.id" },
              { "name": "hindsight.run.id" },
              { "name": "error.type" }
            ],
            "having": { "expression": "" },
            "disabled": false
          }
        }
      ]
    },
    "selectedQueryName": "A",
    "thresholds": {
      "kind": "basic",
      "spec": [
        {
          "name": "critical",
          "target": 0,
          "targetUnit": "",
          "recoveryTarget": null,
          "matchType": "1",
          "op": "1",
          "channels": ["hindsight-replay-engine"]
        }
      ]
    }
  },
  "evaluation": {
    "kind": "rolling",
    "spec": {
      "evalWindow": "1m0s",
      "frequency": "30s"
    }
  },
  "summary": "Agent $hindsight.agent.id run $hindsight.run.id failed ($error.type), trace $trace_id",
  "description": "A trace-correlated recorder event opened a Hindsight incident. trace_id is the authoritative run anchor.",
  "labels": {
    "team": "hindsight",
    "trigger": "run_failed"
  },
  "notificationSettings": {
    "groupBy": ["trace_id", "hindsight.agent.id", "hindsight.run.id", "error.type"],
    "usePolicy": false
  },
  "disabled": false
}
