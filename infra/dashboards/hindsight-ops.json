{
  "//": "UNINSTALLED TEMPLATE. Hindsight :: Ops is importable via SigNoz UI or POST /api/v1/dashboards. Built against SigNoz v0.133.x; installation must be confirmed by the SigNoz API.",
  "hindsightInstallStatus": "template_uninstalled",
  "title": "Hindsight :: Ops",
  "description": "Measured incidents opened, forks run, and verified incident resolution duration.",
  "tags": ["hindsight", "ops", "meta"],
  "version": "v4",
  "uploadedGrafana": false,
  "variables": {},
  "layout": [
    { "i": "incidents-opened", "x": 0, "y": 0, "w": 6, "h": 6, "moved": false, "static": false },
    { "i": "forks-run", "x": 6, "y": 0, "w": 6, "h": 6, "moved": false, "static": false },
    { "i": "mttr-agents", "x": 0, "y": 6, "w": 12, "h": 6, "moved": false, "static": false }
  ],
  "widgets": [
    {
      "id": "incidents-opened",
      "title": "Incidents opened",
      "description": "Total hindsight.incidents.total across the fleet.",
      "panelTypes": "value",
      "yAxisUnit": "short",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryData": [
            {
              "queryName": "A",
              "dataSource": "metrics",
              "aggregateOperator": "sum_rate",
              "aggregateAttribute": {
                "key": "hindsight.incidents.total",
                "dataType": "float64",
                "type": "Sum",
                "isColumn": true
              },
              "timeAggregation": "increase",
              "spaceAggregation": "sum",
              "filters": { "op": "AND", "items": [] },
              "groupBy": [],
              "expression": "A",
              "disabled": false,
              "reduceTo": "sum",
              "legend": "incidents opened"
            }
          ],
          "queryFormulas": []
        }
      }
    },
    {
      "id": "forks-run",
      "title": "Forks run",
      "description": "Total hindsight.forks.total (replay-with-mutation runs).",
      "panelTypes": "value",
      "yAxisUnit": "short",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryData": [
            {
              "queryName": "A",
              "dataSource": "metrics",
              "aggregateOperator": "sum_rate",
              "aggregateAttribute": {
                "key": "hindsight.forks.total",
                "dataType": "float64",
                "type": "Sum",
                "isColumn": true
              },
              "timeAggregation": "increase",
              "spaceAggregation": "sum",
              "filters": { "op": "AND", "items": [] },
              "groupBy": [],
              "expression": "A",
              "disabled": false,
              "reduceTo": "sum",
              "legend": "forks run"
            }
          ],
          "queryFormulas": []
        }
      }
    },
    {
      "id": "mttr-agents",
      "title": "Verified incident resolution duration",
      "description": "Measured time from incident creation to a verified fork resolution.",
      "panelTypes": "value",
      "yAxisUnit": "ms",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryData": [
            {
              "queryName": "A",
              "dataSource": "metrics",
              "aggregateOperator": "avg",
              "aggregateAttribute": {
                "key": "hindsight.incident.resolution.duration",
                "dataType": "float64",
                "type": "Histogram",
                "isColumn": true
              },
              "timeAggregation": "avg",
              "spaceAggregation": "avg",
              "filters": { "op": "AND", "items": [] },
              "groupBy": [],
              "expression": "A",
              "disabled": false,
              "reduceTo": "avg",
              "legend": "resolution duration"
            }
          ],
          "queryFormulas": []
        }
      }
    }
  ]
}
